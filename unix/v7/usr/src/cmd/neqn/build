set -e

sh clean
yacc -d e.y
mv y.tab.c e.c
mv y.tab.h e.def

for f in diacrit eqnbox font fromto funny glob integral io lex lookup
do
	cc -DNEQN -DYYSTYPE=eqn_value -I. -c $f.c
done
for f in mark matrix move over paren pile shift size sqrt text
do
	cc -DNEQN -DYYSTYPE=eqn_value -I. -c $f.c
done
cc -DNEQN -DYYSTYPE=eqn_value -I. -c e.c
cc -s -o neqn *.o
