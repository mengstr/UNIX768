# V7 nm: address, type, name.
s/^\([^ ]*\) [Tt] \(.*\)$/\2 0x\1 text/p
s/^\([^ ]*\) [Dd] \(.*\)$/\2 0x\1 data/p
s/^\([^ ]*\) [BbCc] \(.*\)$/\2 0x\1 bss/p
s/^\([^ ]*\) [Aa] \(.*\)$/\2 0x\1 abs/p

# ackimage -symbols: address, type, flags, name.
s/^\([^ ]*\) 0002 [^ ]* \(.*\)$/\2 0x\1 text/p
s/^\([^ ]*\) 0082 [^ ]* \(.*\)$/\2 0x\1 text/p
s/^\([^ ]*\) 0004 [^ ]* \(.*\)$/\2 0x\1 data/p
s/^\([^ ]*\) 0084 [^ ]* \(.*\)$/\2 0x\1 data/p
s/^\([^ ]*\) 0005 [^ ]* \(.*\)$/\2 0x\1 bss/p
s/^\([^ ]*\) 0085 [^ ]* \(.*\)$/\2 0x\1 bss/p
s/^\([^ ]*\) 0001 [^ ]* \(.*\)$/\2 0x\1 abs/p
s/^\([^ ]*\) 0081 [^ ]* \(.*\)$/\2 0x\1 abs/p
