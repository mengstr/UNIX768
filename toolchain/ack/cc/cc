#!/bin/sh

script_dir=`CDPATH=; cd \`dirname "$0"\` && pwd`
if [ -d "$script_dir/../../toolchain/ack" ]; then
	repo_root=`CDPATH=; cd "$script_dir/../.." && pwd`
else
	repo_root=`CDPATH=; cd "$script_dir/../../.." && pwd`
fi
cc_root="$repo_root/toolchain/ack"
tools_dir="$repo_root/build/toolchain/ack/clang"
runtime_dir="$repo_root/build/toolchain/ack/68kunix"
if [ -x "$script_dir/cpp" ]; then
	bin_dir="$script_dir"
elif [ -x "$repo_root/build/bin/cpp" ]; then
	bin_dir="$repo_root/build/bin"
else
	bin_dir="$tools_dir"
fi

cpp_bin="$bin_dir/cpp"
c1_bin="$bin_dir/c1"
opt_bin="$bin_dir/opt"
opt2_bin="$bin_dir/opt2"
c2_bin="$bin_dir/ncg"
as_bin="$bin_dir/as"
led_bin="$bin_dir/led"
cv_bin="$bin_dir/cv"

c1_flags="-L -Vw2.2i2.2p4.2f4.2s2.2l4.2d8.2x8.2"
crt_object="$runtime_dir/libc_crt0.o"
libc_archive="$runtime_dir/libc.a"
libfp_archive="$runtime_dir/libfp.a"
end_object="$runtime_dir/libc_end.o"

usage() {
	cat <<EOF
usage: cc [-O0|-O1|-O2] [-c] [-k] [-s] [-w] [-o output] [cpp flags] file...

  -O0   run the EM optimizer with -n
  -O1   run the EM optimizer normally
  -O2   run the stronger em_opt2 stage
  -c    stop after object file generation
  -k    keep intermediate files
  -s    strip names and relocation from the final link
  -w    suppress warnings and strict portability diagnostics
  -o    set the output file name

Recognized preprocessor flags:
  -D...  -I...  -U...
EOF
	exit 1
}

die() {
	printf 'cc: %s\n' "$1" >&2
	exit 1
}

require_tool() {
	if [ ! -x "$1" ]; then
		die "missing tool: $1 (run: make -f Makefile.clang all)"
	fi
}

compile_only=0
keep_temps=0
strip_output=0
opt_level=1
output_name=
cpp_flags=
source_inputs=
link_inputs=
need_cpp_arg=

while [ $# -gt 0 ]; do
	if [ -n "$need_cpp_arg" ]; then
		cpp_flags="$cpp_flags $1"
		need_cpp_arg=
		shift
		continue
	fi
	case "$1" in
		-O0)
			opt_level=0
			;;
		-O1)
			opt_level=1
			;;
		-O2)
			opt_level=2
			;;
		-c)
			compile_only=1
			;;
		-k)
			keep_temps=1
			;;
		-s)
			strip_output=1
			;;
		-w)
			c1_flags="$c1_flags -a"
			;;
		-o)
			shift
			[ $# -gt 0 ] || die "-o needs a filename"
			output_name=$1
			;;
		-D*|-I*|-U*)
			cpp_flags="$cpp_flags $1"
			;;
		-D|-I|-U)
			need_cpp_arg=$1
			;;
		-h|--help)
			usage
			;;
		-*)
			die "unsupported option: $1"
			;;
		*.c|*.C)
			source_inputs="$source_inputs $1"
			;;
		*.o)
			link_inputs="$link_inputs $1"
			;;
		*)
			link_inputs="$link_inputs $1"
			;;
	esac
	shift
done

if [ -n "$need_cpp_arg" ]; then
	die "$need_cpp_arg needs an argument"
fi

[ -n "$source_inputs" ] || [ -n "$link_inputs" ] || usage

require_tool "$cpp_bin"
require_tool "$c1_bin"
case "$opt_level" in
	0|1)
		require_tool "$opt_bin"
		;;
	2)
		require_tool "$opt2_bin"
		;;
esac
require_tool "$c2_bin"
require_tool "$as_bin"
if [ "$compile_only" -eq 0 ]; then
	require_tool "$led_bin"
	require_tool "$cv_bin"
fi

if [ "$keep_temps" -eq 1 ]; then
	tmpbase="$repo_root/build/acktemps/cc.$$"
	mkdir -p "$repo_root/build/acktemps" || die "cannot create $repo_root/build/acktemps"
else
	tmpbase=/tmp/cc.$$
fi
tmpdir=
n=0
while [ -z "$tmpdir" ]; do
	trydir="$tmpbase.$n"
	if mkdir "$trydir" 2>/dev/null; then
		tmpdir="$trydir"
	else
		n=`expr "$n" + 1`
	fi
done

cleanup() {
	if [ "$keep_temps" -eq 1 ]; then
		if [ "${ACK_CC_KEEP_TEMPS_VERBOSE:-0}" != 0 ]; then
			printf 'cc: kept intermediates in %s\n' "$tmpdir" >&2
		fi
	else
		rm -rf "$tmpdir"
	fi
}
trap cleanup 0 1 2 15

run_cpp() {
	src=$1
	out=$2
	set -- "$cpp_bin"
	set -- "$@" -I"$cc_root/libc"
	set -- "$@" -I"$repo_root/unix/v7/usr/include"
	for flag in $cpp_flags; do
		set -- "$@" "$flag"
	done
	set -- "$@" "$src"
	"$@" > "$out" || die "cpp failed for $src"
}

compile_one() {
	src=$1
	idx=$2
	stem=`basename "$src"`
	stem=`expr "$stem" : '\(.*\)\..*'`
	if [ -z "$stem" ]; then
		stem=$src
	fi
	tag=`printf '%02d_%s' "$idx" "$stem"`
	i_file="$tmpdir/$tag.i"
	k_file="$tmpdir/$tag.k"
	m_file="$tmpdir/$tag.m"
	s_file="$tmpdir/$tag.s"
	o_file="$tmpdir/$tag.o"

	run_cpp "$src" "$i_file"
	set -- "$c1_bin"
	for flag in $c1_flags; do
		set -- "$@" "$flag"
	done
	set -- "$@" "$i_file" "$k_file"
	"$@" || die "c1 failed for $src"

	case "$opt_level" in
		0)
			"$opt_bin" -n "$k_file" > "$m_file" || die "opt failed for $src"
			;;
		1)
			"$opt_bin" "$k_file" > "$m_file" || die "opt failed for $src"
			;;
		2)
			"$opt2_bin" "$k_file" > "$m_file" || die "opt2 failed for $src"
			;;
		*)
			die "invalid optimization level"
			;;
	esac

	"$c2_bin" "$m_file" "$s_file" || die "ncg failed for $src"
	"$as_bin" - -o "$o_file" "$s_file" || die "as failed for $src"

	if [ "$compile_only" -eq 1 ]; then
		set -- $source_inputs
		if [ -n "$output_name" ] && [ $# -gt 1 ]; then
			die "-o with -c is only supported for a single source file"
		fi
		if [ -n "$output_name" ]; then
			mv "$o_file" "$output_name" || die "cannot write $output_name"
		else
			obj_name=`basename "$src"`
			obj_name=`expr "$obj_name" : '\(.*\)\..*'`.o
			if [ "$obj_name" = ".o" ]; then
				obj_name=`basename "$src"`.o
			fi
			mv "$o_file" "$obj_name" || die "cannot write $obj_name"
		fi
	else
		link_inputs="$link_inputs $o_file"
	fi
}

idx=0
for src in $source_inputs; do
	idx=`expr "$idx" + 1`
	compile_one "$src" "$idx"
done

if [ "$compile_only" -eq 1 ]; then
	exit 0
fi

if [ -n "$output_name" ]; then
	final_output=$output_name
else
	final_output=a.out
fi

ack_output="$tmpdir/`basename "$final_output"`.ack.out"
[ -f "$crt_object" ] || die "missing runtime object: $crt_object (run: make libc)"
[ -f "$libc_archive" ] || die "missing libc archive: $libc_archive (run: make libc)"
[ -f "$libfp_archive" ] || die "missing floating-point archive: $libfp_archive (run: make libc)"
[ -f "$end_object" ] || die "missing runtime object: $end_object (run: make libc)"

# led extracts archive members in a single pass.  Repeat the runtime group so
# libc and libfp can satisfy each other as well as their internal dependencies.
ledger_inputs="$crt_object $link_inputs $libc_archive $libfp_archive $libc_archive $libfp_archive $libc_archive $libfp_archive $end_object"

set -- "$led_bin"
if [ "$strip_output" -eq 1 ]; then
	set -- "$@" -s
fi
set -- "$@" -o "$ack_output"
for item in $ledger_inputs; do
	set -- "$@" "$item"
done
"$@" || die "led failed"

"$cv_bin" "$ack_output" "$final_output" || die "cv failed"
