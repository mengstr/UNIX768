test-cpp: $(CPP_BIN)
	printf '#define X 42\nint a = X;\n' > /tmp/cc-cpp-test.c
	$(CPP_BIN) /tmp/cc-cpp-test.c

test-opt: $(OPT_BIN)
	$(OPT_BIN) /tmp/ack-c1-test.ZSzj3w/test.k > /tmp/ack-c1-test.ZSzj3w/test.m

test-opt2: $(OPT2_BIN)
	$(OPT2_BIN) /tmp/ack-c1-test.ZSzj3w/test.k > /tmp/ack-c1-test.ZSzj3w/test.m

test-ncg: $(CPP_BIN) $(C1_BIN) $(OPT_BIN) $(C2_BIN)
	printf 'int main(void) { return 42; }\n' > /tmp/cc-c2-test.c
	$(CPP_BIN) /tmp/cc-c2-test.c > /tmp/cc-c2-test.i
	$(C1_BIN) -Vw2.2i2.2p4.2f4.2s2.2l4.2d8.2x8.2 /tmp/cc-c2-test.i /tmp/cc-c2-test.k
	$(OPT_BIN) /tmp/cc-c2-test.k > /tmp/cc-c2-test.m
	$(C2_BIN) /tmp/cc-c2-test.m /tmp/cc-c2-test.s

test-as: $(CPP_BIN) $(C1_BIN) $(OPT_BIN) $(C2_BIN) $(AS_BIN)
	printf 'int main(void) { return 42; }\n' > /tmp/cc-as-test.c
	$(CPP_BIN) /tmp/cc-as-test.c > /tmp/cc-as-test.i
	$(C1_BIN) -Vw2.2i2.2p4.2f4.2s2.2l4.2d8.2x8.2 /tmp/cc-as-test.i /tmp/cc-as-test.k
	$(OPT_BIN) /tmp/cc-as-test.k > /tmp/cc-as-test.m
	$(C2_BIN) /tmp/cc-as-test.m /tmp/cc-as-test.s
	$(AS_BIN) - -o /tmp/cc-as-test.o /tmp/cc-as-test.s

clean:
	@rm -f $(CPP_BIN) $(C1_BIN) $(OPT_BIN) $(OPT2_BIN) $(C2_BIN) $(AS_BIN) $(CV_BIN) $(LN_BIN) $(AAL_BIN)
	@rm -rf $(BUILD_DIR)
