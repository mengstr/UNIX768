all: $(CPP_BIN) $(C1_BIN) $(OPT_BIN) $(OPT2_BIN) $(C2_BIN) $(AS_BIN) $(CV_BIN) $(LN_BIN) $(AAL_BIN)

extra-optimizers: $(OPT2_BIN)

$(BIN_DIR):
	@mkdir -p $(BIN_DIR)

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(CPP_BIN): $(BUILD_DIR) $(BIN_DIR) $(CPP_OBJS)
	@printf '%-6s %s\n' 'LD' '$(notdir $@)'
	@$(HOST_CC) -o $(CPP_BIN) $(CPP_OBJS)

$(C1_BIN): $(BUILD_DIR) $(BIN_DIR) $(C1_OBJS)
	@printf '%-6s %s\n' 'LD' '$(notdir $@)'
	@$(HOST_CC) -o $(C1_BIN) $(C1_OBJS)

$(OPT_BIN): $(BUILD_DIR) $(BIN_DIR) $(OPT_OBJS)
