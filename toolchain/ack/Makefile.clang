ROOT := .
ifneq ($(filter ack ACK,$(notdir $(CURDIR))),)
ROOT := ../..
endif

HOST_CC ?= clang

BUILD_DIR = $(ROOT)/build/toolchain/ack/clang
BIN_DIR = $(ROOT)/build/bin
CPP_BIN = $(BIN_DIR)/cpp
C1_BIN = $(BIN_DIR)/c1
OPT_BIN = $(BIN_DIR)/opt
OPT2_BIN = $(BIN_DIR)/opt2
C2_BIN = $(BIN_DIR)/ncg
AS_BIN = $(BIN_DIR)/as
CV_BIN = $(BIN_DIR)/cv
LN_BIN = $(BIN_DIR)/led
AAL_BIN = $(BIN_DIR)/aal
ACK_CFLAGS = -L -Vw2.2i2.2p4.2f4.2s2.2l4.2d8.2x8.2
CPP_CFLAGS = -g -Os \
	-Werror=return-type \
	-Werror=implicit-function-declaration \
	-Werror=strict-prototypes \
	-Wno-format-security \
	-Wno-constant-conversion \
	-DACK_HOST_BUILD=1 \
	-DUNREACHABLE_CODE='__builtin_unreachable()' \
	-DNORETURN=_Noreturn

CPP_INCLUDES = \
	-I$(ROOT)/toolchain/ack/shared/generated/h \
	-I$(ROOT)/toolchain/ack/shared/generated/em_data \
	-I$(ROOT)/toolchain/ack/shared/includes/ack-h \
	-I$(ROOT)/toolchain/ack/shared/includes/modules-h \
	-I$(ROOT)/toolchain/ack/shared/includes/read_em \
	-I$(ROOT)/toolchain/ack/shared/modules/src/alloc \
	-I$(ROOT)/toolchain/ack/shared/modules/src/data \
	-I$(ROOT)/toolchain/ack/shared/modules/src/em_code \
	-I$(ROOT)/toolchain/ack/shared/modules/src/em_data \
	-I$(ROOT)/toolchain/ack/shared/modules/src/flt_arith \
	-I$(ROOT)/toolchain/ack/shared/modules/src/idf \
	-I$(ROOT)/toolchain/ack/shared/modules/src/input \
	-I$(ROOT)/toolchain/ack/shared/modules/src/read_em \
	-I$(ROOT)/toolchain/ack/shared/modules/src/string \
	-I$(ROOT)/toolchain/ack/shared/modules/src/system \
	-I$(ROOT)/toolchain/ack/cpp \
	-I$(ROOT)/toolchain/ack/cpp/generated

